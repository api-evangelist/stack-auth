{
  "opencollection": "1.0.0",
  "info": {
    "name": "Stack REST Auth Team Memberships API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Stack-Project-Id",
      "value": "{{X-Stack-Project-Id}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Team Memberships",
        "type": "folder"
      },
      "items": [
        {
          "info": {
